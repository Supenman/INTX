{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "INTX 桌面窗口：只开核心权限。数据在前端 IndexedDB；fs 仅作用于用户通过系统对话框选中的文件或备份文件夹（dialog 会把该路径加入运行时 scope）。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        },
        {
          "url": "http://localhost:8190/*"
        },
        {
          "url": "http://127.0.0.1:8190/*"
        },
        {
          "url": "http://localhost:8188/*"
        },
        {
          "url": "http://127.0.0.1:8188/*"
        }
      ]
    }
  ]
}
