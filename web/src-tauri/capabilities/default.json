{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "INTX 桌面窗口：只开核心权限。数据全在前端 IndexedDB，Rust 侧不需要 fs。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    }
  ]
}
