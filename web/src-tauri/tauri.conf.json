{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "INTX",
  "version": "0.2.0",
  "identifier": "app.intx.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/prepare-agent-runtime.mjs && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "INTX · 无限画布",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {}
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Supenman/INTX/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_YOUR_UPDATER_PUBLIC_KEY"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/canvas-agent-runtime/": "canvas-agent-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
